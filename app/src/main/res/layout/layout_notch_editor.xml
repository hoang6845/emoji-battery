<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notch_editor"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="213dp"
        android:background="@drawable/bg_notch_panel"
        android:orientation="vertical"
        android:paddingHorizontal="13.5dp"
        android:paddingTop="17dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:layout_marginStart="1.5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="26dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/notch_style_icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:fontFamily="@font/nunito"
                android:fontVariationSettings="&apos;wght&apos; 600"
                android:includeFontPadding="false"
                android:text="Notch Style"
                android:textColor="#27205F"
                android:textFontWeight="600"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/notch_style"
            android:layout_width="match_parent"
            android:layout_height="144dp"
            android:layout_marginTop="9.5dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/notch_style_0"
                android:layout_width="0dp"
                android:layout_height="144dp"
                android:layout_marginStart="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_notch_style"
                android:clickable="true"
                android:contentDescription="No notch"
                android:focusable="true"
                android:padding="9.5dp"
                android:scaleType="fitXY"
                android:src="@drawable/notch_style_preview_0" />

            <ImageView
                android:id="@+id/notch_style_1"
                android:layout_width="0dp"
                android:layout_height="144dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_notch_style"
                android:clickable="true"
                android:contentDescription="Pill notch"
                android:focusable="true"
                android:padding="9.5dp"
                android:scaleType="fitXY"
                android:src="@drawable/notch_style_preview_1" />

            <ImageView
                android:id="@+id/notch_style_2"
                android:layout_width="0dp"
                android:layout_height="144dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_notch_style"
                android:clickable="true"
                android:contentDescription="Wide notch"
                android:focusable="true"
                android:padding="9.5dp"
                android:scaleType="fitXY"
                android:src="@drawable/notch_style_preview_2" />

            <ImageView
                android:id="@+id/notch_style_3"
                android:layout_width="0dp"
                android:layout_height="144dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_notch_style"
                android:clickable="true"
                android:contentDescription="Camera hole"
                android:focusable="true"
                android:padding="9.5dp"
                android:scaleType="fitXY"
                android:src="@drawable/notch_style_preview_3" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="205dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_notch_panel"
        android:orientation="vertical"
        android:paddingHorizontal="13dp"
        android:paddingTop="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="35dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/notch_position_icon" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="13dp"
                android:layout_weight="1"
                android:fontFamily="@font/nunito"
                android:fontVariationSettings="&apos;wght&apos; 600"
                android:includeFontPadding="false"
                android:text="Notch Position"
                android:textColor="#27205F"
                android:textFontWeight="600"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/notch_position"
                android:layout_width="96dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_notch_reset"
                android:clickable="true"
                android:contentDescription="Reset notch position"
                android:elevation="2dp"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/notch_reset_icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:fontFamily="@font/nunito"
                    android:fontVariationSettings="&apos;wght&apos; 600"
                    android:includeFontPadding="false"
                    android:text="Reset"
                    android:textColor="#27205F"
                    android:textFontWeight="600"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="19dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="19dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="@font/nunito"
                    android:fontVariationSettings="&apos;wght&apos; 600"
                    android:includeFontPadding="false"
                    android:text="Vertical"
                    android:textColor="#27205F"
                    android:textFontWeight="600"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/notch_vertical_value"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/nunito"
                    android:fontVariationSettings="&apos;wght&apos; 600"
                    android:includeFontPadding="false"
                    android:text="15dp"
                    android:textColor="#27205F"
                    android:textFontWeight="600"
                    android:textSize="14sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/notch_vertical"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:layout_marginTop="2dp"
                android:contentDescription="Notch vertical"
                android:max="25"
                android:paddingHorizontal="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:progress="15"
                android:progressBackgroundTint="@null"
                android:progressDrawable="@drawable/bg_notch_slider"
                android:progressTint="@null"
                android:splitTrack="false"
                android:thumb="@drawable/bg_slider_thumb"
                android:thumbOffset="0dp"
                android:thumbTint="@null" />

            <Space
                android:layout_width="1dp"
                android:layout_height="19dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="19dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="@font/nunito"
                    android:fontVariationSettings="&apos;wght&apos; 600"
                    android:includeFontPadding="false"
                    android:text="Horizontal"
                    android:textColor="#27205F"
                    android:textFontWeight="600"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/notch_horizontal_value"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/nunito"
                    android:fontVariationSettings="&apos;wght&apos; 600"
                    android:includeFontPadding="false"
                    android:text="10dp"
                    android:textColor="#27205F"
                    android:textFontWeight="600"
                    android:textSize="14sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/notch_horizontal"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:layout_marginTop="2dp"
                android:contentDescription="Notch horizontal"
                android:max="25"
                android:paddingHorizontal="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:progress="10"
                android:progressBackgroundTint="@null"
                android:progressDrawable="@drawable/bg_notch_slider"
                android:progressTint="@null"
                android:splitTrack="false"
                android:thumb="@drawable/bg_slider_thumb"
                android:thumbOffset="0dp"
                android:thumbTint="@null" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="205dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_notch_panel"
        android:orientation="vertical"
        android:paddingHorizontal="13dp"
        android:paddingTop="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="35dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/notch_size_icon" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="13dp"
                android:layout_weight="1"
                android:fontFamily="@font/nunito"
                android:fontVariationSettings="&apos;wght&apos; 600"
                android:includeFontPadding="false"
                android:text="Notch Size"
                android:textColor="#27205F"
                android:textFontWeight="600"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="19dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="19dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="@font/nunito"
                    android:fontVariationSettings="&apos;wght&apos; 600"
                    android:includeFontPadding="false"
                    android:text="Height"
                    android:textColor="#27205F"
                    android:textFontWeight="600"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/notch_height_value"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/nunito"
                    android:fontVariationSettings="&apos;wght&apos; 600"
                    android:includeFontPadding="false"
                    android:text="15dp"
                    android:textColor="#27205F"
                    android:textFontWeight="600"
                    android:textSize="14sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/notch_height"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:layout_marginTop="2dp"
                android:contentDescription="Notch height"
                android:max="25"
                android:paddingHorizontal="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:progress="15"
                android:progressBackgroundTint="@null"
                android:progressDrawable="@drawable/bg_notch_slider"
                android:progressTint="@null"
                android:splitTrack="false"
                android:thumb="@drawable/bg_slider_thumb"
                android:thumbOffset="0dp"
                android:thumbTint="@null" />

            <Space
                android:layout_width="1dp"
                android:layout_height="19dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="19dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="@font/nunito"
                    android:fontVariationSettings="&apos;wght&apos; 600"
                    android:includeFontPadding="false"
                    android:text="Width"
                    android:textColor="#27205F"
                    android:textFontWeight="600"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/notch_width_value"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/nunito"
                    android:fontVariationSettings="&apos;wght&apos; 600"
                    android:includeFontPadding="false"
                    android:text="10dp"
                    android:textColor="#27205F"
                    android:textFontWeight="600"
                    android:textSize="14sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/notch_width"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:layout_marginTop="2dp"
                android:contentDescription="Notch width"
                android:max="25"
                android:paddingHorizontal="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:progress="10"
                android:progressBackgroundTint="@null"
                android:progressDrawable="@drawable/bg_notch_slider"
                android:progressTint="@null"
                android:splitTrack="false"
                android:thumb="@drawable/bg_slider_thumb"
                android:thumbOffset="0dp"
                android:thumbTint="@null" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/notch_save"
        android:layout_width="match_parent"
        android:layout_height="57dp"
        android:fontFamily="@font/nunito"
        android:fontVariationSettings="&apos;wght&apos; 600"
        android:includeFontPadding="false"
        android:text="Apply"
        android:textColor="#27205F"
        android:textFontWeight="600"
        android:textSize="18sp" />
</LinearLayout>