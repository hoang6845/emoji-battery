<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/status_overlay_strip" android:layout_width="match_parent" android:layout_height="30dp" android:background="@drawable/bg_status_overlay" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp">
    <TextClock android:id="@+id/status_overlay_clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="h:mm" android:format24Hour="HH:mm" android:textColor="#27205F" android:textSize="12sp" />
    <TextView android:id="@+id/status_overlay_emoji" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="🐶" android:textColor="#27205F" android:textSize="15sp" />
    <TextView android:id="@+id/status_overlay_battery" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="86% ▰" android:textColor="#27205F" android:textSize="12sp" android:textStyle="bold" />
</LinearLayout>
