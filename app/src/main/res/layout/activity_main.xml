<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/activity_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:orientation="vertical">

    <LinearLayout android:id="@+id/battery_content_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <FrameLayout
        android:id="@+id/main_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <include layout="@layout/app_bottom_nav" />
    <FrameLayout android:id="@+id/battery_home_mini_host" android:layout_width="match_parent" android:layout_height="54dp" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:id="@+id/battery_bottom_dock" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical">
    <FrameLayout android:id="@+id/battery_action_host" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <FrameLayout
        android:id="@+id/battery_ad_host"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    </LinearLayout>
</FrameLayout>
