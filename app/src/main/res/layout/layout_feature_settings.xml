<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="24dp">
    <LinearLayout android:id="@+id/settings_main_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <LinearLayout android:id="@+id/settings_top_actions" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/settings_search" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:background="@drawable/bg_plan" android:drawableStart="@drawable/ic_search" android:gravity="center_vertical" android:paddingStart="14dp" android:text="@string/search" android:textColor="#897CE7" android:textSize="14sp" />
        <TextView android:id="@+id/settings_library" android:layout_width="104dp" android:layout_height="44dp" android:layout_marginStart="7dp" android:background="@drawable/bg_plan" android:gravity="center" android:text="@string/my_library" android:textColor="#27205F" android:textSize="14sp" />
        <TextView android:id="@+id/settings_premium_shortcut" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="7dp" android:background="@drawable/bg_plan" android:gravity="center" android:text="♛" android:textColor="#27205F" android:textSize="22sp" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical" android:text="@string/general" android:textColor="#30255F" android:textSize="13sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_home_panel" android:orientation="vertical" android:padding="10dp">
    <TextView android:id="@+id/settings_premium" style="@style/FeaturePrimary" android:visibility="gone" android:text="@string/get_premium" />
    <TextView android:id="@+id/settings_how_to" style="@style/FeatureAction" android:visibility="gone" android:text="@string/how_to_use" />
    <TextView android:id="@+id/settings_restricted" style="@style/FeatureAction" android:text="@string/restricted_apps" />
    <TextView android:id="@+id/settings_language" style="@style/FeatureAction" android:text="@string/language" />
    <TextView android:id="@+id/settings_feedback" style="@style/FeatureAction" android:text="@string/feedback" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="10dp" android:gravity="center_vertical" android:text="@string/about_legal" android:textColor="#30255F" android:textSize="13sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_home_panel" android:orientation="vertical" android:padding="10dp">
    <TextView android:id="@+id/settings_privacy" style="@style/FeatureAction" android:text="@string/privacy_policy" />
    <TextView android:id="@+id/settings_terms" style="@style/FeatureAction" android:text="@string/terms_of_use" />
    <TextView android:id="@+id/settings_dmca" style="@style/FeatureAction" android:text="@string/dmca_notice" />
    </LinearLayout>
    <TextView android:id="@+id/settings_version" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="18dp" android:text="Emoji Battery" android:textColor="#897CE7" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/settings_language_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <EditText android:id="@+id/language_search" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="12dp" android:background="@drawable/bg_plan" android:hint="Search language" android:paddingHorizontal="16dp" android:singleLine="true" android:textColor="#30255F" android:textSize="14sp" />
        <RadioGroup android:id="@+id/language_options" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_home_panel" android:orientation="vertical" android:paddingHorizontal="14dp">
            <RadioButton android:id="@+id/language_english" android:layout_width="match_parent" android:layout_height="54dp" android:buttonTint="#8B69FB" android:text="English" android:textColor="#30255F" android:textSize="15sp" />
            <RadioButton android:id="@+id/language_vietnamese" android:layout_width="match_parent" android:layout_height="54dp" android:buttonTint="#8B69FB" android:text="Vietnamese" android:textColor="#30255F" android:textSize="15sp" />
            <RadioButton android:id="@+id/language_french" android:layout_width="match_parent" android:layout_height="54dp" android:buttonTint="#8B69FB" android:text="French" android:textColor="#30255F" android:textSize="15sp" />
            <RadioButton android:id="@+id/language_german" android:layout_width="match_parent" android:layout_height="54dp" android:buttonTint="#8B69FB" android:text="German" android:textColor="#30255F" android:textSize="15sp" />
            <RadioButton android:id="@+id/language_spanish" android:layout_width="match_parent" android:layout_height="54dp" android:buttonTint="#8B69FB" android:text="Spanish" android:textColor="#30255F" android:textSize="15sp" />
            <RadioButton android:id="@+id/language_portuguese" android:layout_width="match_parent" android:layout_height="54dp" android:buttonTint="#8B69FB" android:text="Portuguese" android:textColor="#30255F" android:textSize="15sp" />
            <RadioButton android:id="@+id/language_italian" android:layout_width="match_parent" android:layout_height="54dp" android:buttonTint="#8B69FB" android:text="Italian" android:textColor="#30255F" android:textSize="15sp" />
            <RadioButton android:id="@+id/language_russian" android:layout_width="match_parent" android:layout_height="54dp" android:buttonTint="#8B69FB" android:text="Russian" android:textColor="#30255F" android:textSize="15sp" />
            <RadioButton android:id="@+id/language_indonesian" android:layout_width="match_parent" android:layout_height="54dp" android:buttonTint="#8B69FB" android:text="Indonesian" android:textColor="#30255F" android:textSize="15sp" />
            <RadioButton android:id="@+id/language_dutch" android:layout_width="match_parent" android:layout_height="54dp" android:buttonTint="#8B69FB" android:text="Dutch" android:textColor="#30255F" android:textSize="15sp" />
            <RadioButton android:id="@+id/language_romanian" android:layout_width="match_parent" android:layout_height="54dp" android:buttonTint="#8B69FB" android:text="Romanian" android:textColor="#30255F" android:textSize="15sp" />
        </RadioGroup>
        <TextView android:id="@+id/language_save" style="@style/FeaturePrimary" android:text="@string/save" />
    </LinearLayout>
    <LinearLayout android:id="@+id/settings_help_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_home_panel" android:orientation="vertical" android:padding="18dp" android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Set up Emoji Battery" android:textColor="#30255F" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:lineSpacingExtra="8dp" android:text="1. Choose an emoji, sticker, or pet from Home.\n\n2. Select a charging animation or wallpaper.\n\n3. Tap Apply to save your style.\n\n4. Allow display over other apps when you enable a floating pet or status bar." android:textColor="#5C5680" android:textSize="15sp" />
        <TextView android:id="@+id/help_home" style="@style/FeaturePrimary" android:text="Go to Home" />
    </LinearLayout>
    <LinearLayout android:id="@+id/settings_feedback_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="54dp" android:gravity="center_vertical" android:text="What can we improve?" android:textColor="#30255F" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/feedback_reason_issue" style="@style/FeatureAction" android:text="Something is not working   ›" />
        <TextView android:id="@+id/feedback_reason_suggestion" style="@style/FeatureAction" android:text="I have a suggestion   ›" />
        <TextView android:id="@+id/feedback_reason_help" style="@style/FeatureAction" android:text="I need help   ›" />
        <TextView android:id="@+id/feedback_reason_other" style="@style/FeatureAction" android:text="Other   ›" />
        <TextView android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center" android:text="Your feedback helps us improve" android:textColor="#897CE7" android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/settings_feedback_sent" android:layout_width="match_parent" android:layout_height="300dp" android:gravity="center" android:orientation="vertical" android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💜" android:textSize="64sp" />
        <TextView android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center" android:text="Thank you for your feedback!" android:textColor="#30255F" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/feedback_done" style="@style/FeaturePrimary" android:text="Done" />
    </LinearLayout>
    <LinearLayout android:id="@+id/settings_restricted_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_home_panel" android:orientation="vertical" android:padding="18dp" android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Choose apps that should not be affected by battery restrictions." android:textColor="#5C5680" android:textSize="15sp" />
        <TextView android:id="@+id/restricted_open" style="@style/FeaturePrimary" android:text="Open battery settings" />
    </LinearLayout>
</LinearLayout>
