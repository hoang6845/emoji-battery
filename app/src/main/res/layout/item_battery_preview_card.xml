<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="230dp" android:layout_height="match_parent" android:clipChildren="false" android:clipToPadding="false">
    <FrameLayout android:id="@+id/battery_preview_surface" android:layout_width="272dp" android:layout_height="272dp" android:layout_gravity="center" android:background="@drawable/bg_preview_card" android:elevation="4dp">
        <ImageView android:id="@+id/battery_preview_image" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="44dp" android:scaleType="fitCenter" android:contentDescription="Battery style preview"/>
        <ImageButton android:id="@+id/battery_preview_heart" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="top|end" android:layout_margin="12dp" android:background="@drawable/figma_charging_heart" android:contentDescription="Add favorite"/>
    </FrameLayout>
</FrameLayout>
