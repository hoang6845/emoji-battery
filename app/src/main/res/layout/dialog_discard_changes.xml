<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="@drawable/bg_home_panel">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Discard Changes?" android:textColor="#27205F" android:textSize="18sp" android:textStyle="bold"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="You have unsaved changes. Are you sure you want to leave?" android:textColor="#9B93BC" android:textSize="13sp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="18dp">
        <TextView android:id="@+id/discard_exit" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="8dp" android:gravity="center" android:background="@drawable/bg_catalog_card" android:text="Exit" android:textColor="#27205F"/>
        <TextView android:id="@+id/discard_keep" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:background="@drawable/bg_primary_button" android:text="Keep Editing" android:textColor="#FFFFFF"/>
    </LinearLayout>
</LinearLayout>
