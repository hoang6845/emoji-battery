<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/bg_catalog_card">
    <ImageButton android:id="@+id/unlock_close" android:layout_width="48dp" android:layout_height="48dp"
        android:layout_gravity="end" android:layout_marginTop="24dp" android:layout_marginEnd="24dp" android:padding="12dp" android:src="@drawable/ic_ads_close" android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/battery_ad_close" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp" android:gravity="center" android:text="@string/battery_unlock_title" android:textColor="#30255F"
        android:textSize="22sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp" android:layout_marginVertical="16dp" android:gravity="center"
        android:text="@string/battery_unlock_description" android:textColor="#665F80" />
    <LinearLayout android:id="@+id/unlock_watch" android:layout_width="match_parent" android:layout_height="56dp"
        android:layout_marginHorizontal="24dp" android:gravity="center" android:orientation="horizontal" android:background="@drawable/bg_primary_button"
        android:clickable="true" android:focusable="true" android:contentDescription="@string/battery_unlock_watch">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_ads_video" android:importantForAccessibility="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp"
            android:text="@string/battery_unlock_watch" android:textColor="#FFFFFF" android:textSize="16sp" android:importantForAccessibility="no" />
    </LinearLayout>
    <TextView android:id="@+id/unlock_premium" android:layout_width="match_parent" android:layout_height="56dp"
        android:layout_marginHorizontal="24dp" android:layout_marginTop="12dp" android:layout_marginBottom="24dp" android:gravity="center" android:background="@drawable/bg_plan"
        android:text="@string/battery_unlock_premium" android:textColor="#8B69FB" android:textSize="16sp" />
    <tpt.dev.monetization.ads.nativeAd.view.ViewNativeAd android:id="@+id/unlock_native"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
