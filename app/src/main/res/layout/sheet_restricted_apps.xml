<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_intro_panel" android:padding="24dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Restricted apps" android:textColor="#27205F" android:textSize="18sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Hide all Emoji Battery overlays in selected apps. Recognized banking apps are selected by default." android:textColor="#897CE7" android:textSize="14sp" />
    <TextView android:id="@+id/restricted_accessibility" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp" android:text="Enable Accessibility to detect apps and hide overlays in selected apps. Pet and charging overlays can run without app detection." android:textColor="#27205F" android:clickable="true" android:focusable="true" />
    <ScrollView android:layout_width="match_parent" android:layout_height="260dp"><LinearLayout android:id="@+id/restricted_apps_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" /></ScrollView>
    <TextView android:id="@+id/restricted_apply" style="@style/FeaturePrimary" android:text="Apply" />
</LinearLayout>
