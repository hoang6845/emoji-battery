<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/charging_full_screen" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/charging_scene" android:contentDescription="@string/charging_scene" />
    <ImageButton android:id="@+id/charging_full_back" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="top|start" android:layout_marginStart="14dp" android:layout_marginTop="10dp" android:gravity="center" android:contentDescription="Back" android:background="@drawable/bg_back_button" android:src="@drawable/figma_back" android:scaleType="centerInside" />
    <TextView android:layout_width="match_parent" android:layout_height="48dp" android:layout_gravity="top" android:gravity="center" android:text="@string/charging_battery" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
    <LinearLayout android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center_horizontal|bottom" android:layout_marginBottom="104dp" android:gravity="center" android:orientation="vertical">
        <TextView android:id="@+id/charging_full_percent" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#FFFFFF" android:textSize="90sp" android:textStyle="bold" android:shadowColor="#6550B1" android:shadowDx="0" android:shadowDy="2" android:shadowRadius="5" />
        <TextView android:id="@+id/charging_full_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:gravity="center" android:text="Not charging in progress" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="210dp" android:layout_height="72dp" android:layout_marginTop="14dp" android:gravity="center" android:orientation="horizontal">
            <TextView android:id="@+id/charging_full_temp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Unknown" android:drawableTop="@drawable/figma_charging_time" android:drawablePadding="14dp" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/charging_full_voltage" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="3.79V" android:drawableTop="@drawable/figma_charging_power" android:drawablePadding="14dp" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/charging_full_apply" android:layout_width="match_parent" android:layout_height="56dp" android:layout_gravity="bottom" android:layout_marginStart="26dp" android:layout_marginEnd="26dp" android:layout_marginBottom="22dp" android:background="@drawable/bg_primary_button" android:gravity="center" android:text="@string/apply" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold" />
</FrameLayout>
