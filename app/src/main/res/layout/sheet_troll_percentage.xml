<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="19dp" android:paddingTop="13dp" android:paddingBottom="25dp" android:background="@drawable/bg_troll_sheet">
    <View android:layout_width="70dp" android:layout_height="6dp" android:layout_gravity="center_horizontal" android:layout_marginBottom="24dp" android:background="#C7C7C7"/>
    <TextView android:layout_width="match_parent" android:layout_height="22dp" android:gravity="center" android:text="Edit percentage" android:textColor="#27205F" android:textSize="18sp" android:fontFamily="@font/nunito_family"/>
    <EditText android:id="@+id/percentage_input" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="18dp" android:gravity="center" android:inputType="number" android:maxLength="3" android:background="@drawable/bg_troll_input" android:backgroundTint="@null" android:textColor="#27205F" android:textSize="24sp" android:fontFamily="@font/nunito_family" android:selectAllOnFocus="true"/>
    <TextView android:layout_width="match_parent" android:layout_height="19dp" android:layout_marginTop="18dp" android:gravity="center" android:text="Enter any number you like" android:textColor="#8F85B5" android:textSize="14sp"/>
    <TextView android:id="@+id/percentage_apply" android:layout_width="match_parent" android:layout_height="57dp" android:layout_marginTop="18dp" android:gravity="center" android:background="@drawable/bg_primary_button" android:text="Apply" android:textSize="18sp" android:textColor="#FFFFFF"/>
    <TextView android:id="@+id/percentage_cancel" android:layout_width="match_parent" android:layout_height="19dp" android:layout_marginTop="18dp" android:gravity="center" android:text="Cancel" android:textSize="14sp" android:textColor="#8F85B5"/>
</LinearLayout>
