<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/bg_screen_gradient"
    android:fitsSystemWindows="true" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical">
        <ImageButton android:id="@+id/background_crop_back" android:layout_width="44dp" android:layout_height="44dp" android:contentDescription="Back" android:background="@drawable/bg_back_button" android:src="@drawable/figma_back" android:scaleType="centerInside" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Crop image" android:textSize="22sp" android:textColor="#27205F" android:textStyle="bold" />
        <Space android:layout_width="44dp" android:layout_height="44dp" />
    </LinearLayout>
    <com.canhub.cropper.CropImageView android:id="@+id/background_crop_image" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical">
        <Button android:id="@+id/background_crop_reset" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Reset" />
        <Button android:id="@+id/background_crop_rotate" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Rotate" />
    </LinearLayout>
    <TextView android:id="@+id/background_crop_apply" style="@style/FeaturePrimary" android:text="Apply" />
</LinearLayout>
