<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/pet_permission_overlay" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#99000000" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:background="@drawable/bg_bottom_sheet" android:orientation="vertical" android:paddingStart="19dp" android:paddingTop="22dp" android:paddingEnd="19dp" android:paddingBottom="18dp">
        <TextView android:layout_width="match_parent" android:layout_height="35dp" android:gravity="center_vertical" android:text="⚠  Permission Required" android:textColor="#30255F" android:textSize="17sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Allow Display over other apps to display your custom battery features" android:textColor="#897CE7" android:textSize="14sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="#EEEAFE" android:orientation="vertical" android:padding="14dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Follow these steps to grant permission:" android:textColor="#30255F" android:textSize="13sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:lineSpacingExtra="5dp" android:text="1. Go to Settings\n2. Select “App name”\n3. Allow the permission: “Display over other apps”" android:textColor="#30255F" android:textSize="13sp" />
            <TextView android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginTop="10dp" android:background="@drawable/bg_plan" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="Display over other apps                 ○" android:textColor="#30255F" android:textSize="13sp" />
        </LinearLayout>
        <TextView android:id="@+id/pet_permission_continue" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:background="@drawable/bg_primary_button" android:gravity="center" android:text="Continue to Settings" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/pet_permission_dismiss" android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center" android:text="Not now" android:textColor="#897CE7" android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
