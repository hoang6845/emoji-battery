<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:fontFamily="@font/nunito_family" android:background="@drawable/bg_screen_gradient">
    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
        <ImageView android:id="@+id/image_intro" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:contentDescription="@string/intro_art" />
        <TextView android:id="@+id/button_skip" android:layout_width="wrap_content" android:layout_height="38dp" android:layout_gravity="top|end" android:layout_margin="18dp" android:gravity="center" android:paddingHorizontal="16dp" android:text="@string/intro_skip" android:textColor="#27205F" android:background="@drawable/bg_plan" />
    </FrameLayout>
    <LinearLayout android:id="@+id/intro_panel" android:layout_gravity="bottom" android:layout_width="match_parent" android:layout_height="256dp" android:orientation="vertical" android:gravity="center_horizontal" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="26dp" android:background="@drawable/bg_intro_panel">
        <TextView android:id="@+id/text_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start" android:textColor="#27205F" android:textSize="26sp" android:textStyle="bold" />
        <TextView android:id="@+id/text_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="start" android:textColor="#27205F" android:textSize="18sp" />
        <LinearLayout android:id="@+id/intro_indicators" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="36dp" android:gravity="center">
            <View android:id="@+id/indicator1" style="@style/IntroIndicator" /><View android:id="@+id/indicator2" style="@style/IntroIndicator" /><View android:id="@+id/indicator3" style="@style/IntroIndicator" /><View android:id="@+id/indicator4" style="@style/IntroIndicator" />
        </LinearLayout>
        <TextView android:id="@+id/intro_inline_next" android:layout_width="match_parent" android:layout_height="32dp" android:gravity="end|center_vertical" android:text="Next" android:textColor="#897CE7" android:textSize="16sp" android:visibility="gone" />
        <View android:id="@+id/intro_ad_space" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <TextView android:id="@+id/button_next" android:layout_width="match_parent" android:layout_height="57dp" android:layout_marginTop="19dp" android:layout_marginBottom="26dp" android:gravity="center" android:text="@string/intro_next" android:textColor="@android:color/white" android:textSize="18sp" android:textStyle="bold" android:background="@drawable/bg_primary_button" />
    </LinearLayout>
</FrameLayout>
