<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/home_search"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_plan"
            android:drawableStart="@drawable/ic_search"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:text="@string/search"
            android:textColor="#897CE7"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/home_library"
            android:layout_width="104dp"
            android:layout_height="44dp"
            android:layout_marginStart="7dp"
            android:background="@drawable/bg_plan"
            android:gravity="center"
            android:text="@string/my_library"
            android:textColor="#27205F"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/home_premium"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="7dp"
            android:background="@drawable/bg_plan"
            android:gravity="center"
            android:textColor="#27205F"
            android:textSize="22sp"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/home_banner"
        android:layout_width="match_parent"
        android:layout_height="127dp"
        android:layout_marginTop="18dp"
        android:contentDescription="@string/add_cute_stickers"
        android:scaleType="centerCrop"
        android:src="@drawable/home_sticker_banner" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_home_panel"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/shortcut_pet"
                style="@style/HomeShortcut"
                android:contentDescription="@string/home_pet">

                <pl.droidsonroids.gif.GifImageView
                    style="@style/HomeShortcutTile"
                    android:src="@drawable/mode_pet"
                    />

                <TextView
                    style="@style/HomeShortcutLabel"
                    android:text="@string/home_pet" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/shortcut_diy"
                style="@style/HomeShortcut"
                android:layout_marginStart="7dp"
                android:contentDescription="@string/home_battery_diy">

                <ImageView style="@style/HomeShortcutTile"
                    android:src="@drawable/mode_battery"
                    />
                <TextView
                    style="@style/HomeShortcutLabel"
                    android:text="@string/home_battery_diy" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/shortcut_charge"
                style="@style/HomeShortcut"
                android:layout_marginStart="7dp"
                android:contentDescription="@string/home_battery_charging">

                <ImageView style="@style/HomeShortcutTile"
                    android:src="@drawable/mode_charge"
                    />
                <TextView
                    style="@style/HomeShortcutLabel"
                    android:text="@string/home_battery_charging" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/shortcut_troll"
                style="@style/HomeShortcut"
                android:layout_marginStart="7dp"
                android:contentDescription="@string/home_battery_troll">

                <ImageView style="@style/HomeShortcutTile"
                    android:src="@drawable/mode_troll"
                    />
                <TextView
                    style="@style/HomeShortcutLabel"
                    android:text="@string/home_battery_troll" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_plan"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/enable_emoji_battery"
                android:textColor="#27205F"
                android:textSize="13sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/home_enable"
                android:layout_width="60dp"
                android:layout_height="48dp"
                android:showText="false" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="63dp"
            android:layout_height="34dp"
            android:layout_marginEnd="7dp"
            android:src="@drawable/figma_home_hot"
            android:contentDescription="@string/hot" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/home_categories"
            android:layout_width="0dp"
            android:layout_height="23dp"
            android:layout_weight="1"
            android:scrollbars="none" />

        <ImageButton
            android:id="@+id/home_sort"
            android:layout_width="39dp"
            android:layout_height="34dp"
            android:padding="0dp"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="1dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/figma_home_category_menu"
            android:scaleType="fitCenter"
            android:contentDescription="@string/home_category_open" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/home_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false" />
</LinearLayout>
