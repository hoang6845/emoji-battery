<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="207dp" android:background="@drawable/bg_pet_dialog" android:orientation="vertical" android:gravity="center_horizontal" android:paddingHorizontal="28dp" android:paddingTop="25dp" android:paddingBottom="25dp">
    <TextView android:layout_width="match_parent" android:layout_height="28dp" android:gravity="center" android:text="Downloading, please wait!" android:textColor="#27205F" android:textSize="18sp" />
    <ProgressBar android:id="@+id/pet_download_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="9dp" android:layout_marginTop="12dp" android:progressDrawable="@drawable/pet_download_progress" android:max="100" />
    <TextView android:id="@+id/pet_download_percent" android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center" android:text="0%" android:textColor="#8566FF" android:textSize="18sp" />
    <TextView android:id="@+id/pet_download_cancel" android:layout_width="137dp" android:layout_height="51dp" android:layout_marginTop="21dp" android:background="@drawable/bg_pet_cancel" android:gravity="center" android:text="Cancel" android:textColor="#8566FF" android:textSize="18sp" />
</LinearLayout>