<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/app_bottom_nav" android:layout_width="match_parent" android:layout_height="87dp"
    android:orientation="horizontal" android:gravity="center" android:paddingStart="16.5dp"
    android:paddingEnd="16.5dp" android:background="@drawable/bg_bottom_nav" android:elevation="5dp">
    <LinearLayout android:id="@+id/nav_home" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="30dp" android:layout_height="30dp"
            android:layout_marginBottom="11dp" android:duplicateParentState="true"
            android:src="@drawable/nav_home_states" android:importantForAccessibility="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="19dp" android:gravity="center"
            android:fontFamily="@font/nunito_family" android:includeFontPadding="false" android:maxLines="1"
            android:text="Home" android:textSize="14sp" android:textColor="#9E9E9E" />
    </LinearLayout>
    <LinearLayout android:id="@+id/nav_pet" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="36dp" android:layout_height="36dp"
            android:layout_marginBottom="8dp" android:duplicateParentState="true"
            android:src="@drawable/nav_pet_states" android:importantForAccessibility="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="19dp" android:gravity="center"
            android:fontFamily="@font/nunito_family" android:includeFontPadding="false" android:maxLines="1"
            android:text="Pet" android:textSize="14sp" android:textColor="#9E9E9E" />
    </LinearLayout>
    <LinearLayout android:id="@+id/nav_customize" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="30dp" android:layout_height="30dp"
            android:layout_marginBottom="11dp" android:duplicateParentState="true"
            android:src="@drawable/nav_customize_states" android:importantForAccessibility="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="19dp" android:gravity="center"
            android:fontFamily="@font/nunito_family" android:includeFontPadding="false" android:maxLines="1"
            android:text="Customize" android:textSize="14sp" android:textColor="#9E9E9E" />
    </LinearLayout>
    <LinearLayout android:id="@+id/nav_settings" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="30dp" android:layout_height="30dp"
            android:layout_marginBottom="11dp" android:duplicateParentState="true"
            android:src="@drawable/nav_settings_states" android:importantForAccessibility="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="19dp" android:gravity="center"
            android:fontFamily="@font/nunito_family" android:includeFontPadding="false" android:maxLines="1"
            android:text="Setting" android:textSize="14sp" android:textColor="#9E9E9E" />
    </LinearLayout>
</LinearLayout>
