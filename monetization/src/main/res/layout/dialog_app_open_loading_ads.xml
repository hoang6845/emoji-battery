<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
 android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center"
 android:orientation="vertical" android:background="#F8F5FF">
 <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/battery_welcome_back"
 android:textColor="#30255F" android:textSize="26sp" android:textStyle="bold" />
 <com.airbnb.lottie.LottieAnimationView android:id="@+id/animation_view"
 android:layout_width="96dp" android:layout_height="96dp" android:layout_marginTop="24dp"
 app:lottie_rawRes="@raw/battery_ads_loading" app:lottie_autoPlay="true" app:lottie_loop="true" />
 <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp"
 android:text="@string/loading_ads_msg" android:textColor="#665F80" android:textSize="16sp" />
</LinearLayout>
