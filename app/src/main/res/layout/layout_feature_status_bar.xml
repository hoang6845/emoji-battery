<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="24dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="118dp" android:background="@drawable/bg_home_panel" android:gravity="center" android:orientation="vertical">
        <TextView android:id="@+id/status_preview_emoji" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="😊" android:textSize="36sp" />
        <TextView android:id="@+id/status_preview_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="86%  ▰▰▰" android:textColor="#27205F" android:textSize="17sp" android:textStyle="bold" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/status_categories" android:layout_width="match_parent" android:layout_height="46dp" />
    <TextView android:id="@+id/status_picker_title" style="@style/FeatureSection" android:text="Emoji" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/status_grid" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" />
    <TextView android:id="@+id/status_date" style="@style/FeatureAction" android:text="◷   Date and time" />
    <TextView android:id="@+id/status_apply" style="@style/FeaturePrimary" android:text="Apply" />
</LinearLayout>
