<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/battery_preview_screen" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
    <FrameLayout android:layout_width="match_parent" android:layout_height="64dp">
        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="@string/preview" android:textColor="#30255F" android:textSize="20sp" android:textStyle="bold"/>
        <ImageButton android:id="@+id/battery_preview_back" android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="center_vertical|start" android:layout_marginStart="18dp" android:contentDescription="Back" android:background="@drawable/bg_back_button" android:src="@drawable/figma_back" android:scaleType="centerInside"/>
    </FrameLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:paddingVertical="32dp">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/battery_preview_cards" android:layout_width="match_parent" android:layout_height="300dp" android:clipToPadding="false" android:clipChildren="false" android:overScrollMode="never" android:paddingVertical="12dp"/>
            <TextView android:id="@+id/battery_preview_get" android:layout_width="230dp" android:layout_height="56dp" android:layout_marginTop="30dp" android:layout_marginBottom="24dp" android:background="@drawable/bg_primary_button" android:gravity="center" android:text="@string/get" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
