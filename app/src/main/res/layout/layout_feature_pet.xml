<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="20dp">
    <LinearLayout android:id="@+id/pet_top_actions" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/pet_search" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:background="@drawable/bg_plan" android:drawableStart="@drawable/ic_search" android:gravity="center_vertical" android:paddingStart="14dp" android:text="@string/search" android:textColor="#897CE7" android:textSize="14sp" />
        <TextView android:id="@+id/pet_library" android:layout_width="104dp" android:layout_height="44dp" android:layout_marginStart="7dp" android:background="@drawable/bg_plan" android:gravity="center" android:text="@string/my_library" android:textColor="#27205F" android:textSize="14sp" />
        <TextView android:id="@+id/pet_premium" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="7dp" android:background="@drawable/bg_plan" android:gravity="center" android:text="♛" android:textColor="#27205F" android:textSize="22sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/pet_browse_header" android:layout_width="match_parent" android:layout_height="54dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
        <TextView android:id="@+id/pet_browse_back" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_plan" android:gravity="center" android:text="‹" android:textColor="#30255F" android:textSize="30sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="@string/choose_your_pet" android:textColor="#30255F" android:textSize="20sp" android:textStyle="bold" />
        <View android:layout_width="44dp" android:layout_height="44dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:background="@drawable/bg_plan" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="10dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/enable_emoji_battery" android:textColor="#27205F" android:textSize="13sp" />
        <TextView android:id="@+id/pet_enable" android:layout_width="78dp" android:layout_height="40dp" android:background="@drawable/bg_primary_button" android:gravity="center" android:text="@string/start" android:textColor="#FFFFFF" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/pet_slots_title" android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical" android:text="@string/pet_count" android:textColor="#30255F" android:textSize="14sp" />
    <GridLayout android:id="@+id/pet_slots" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="3" android:rowCount="2" android:useDefaultMargins="true">
        <TextView style="@style/PetSlot" android:text="@string/add_new" />
        <TextView style="@style/PetSlot" android:text="＋" />
        <TextView style="@style/PetSlot" android:text="＋" />
        <TextView style="@style/PetSlot" android:text="＋" />
        <TextView style="@style/PetSlot" android:text="＋" />
        <TextView style="@style/PetSlot" android:text="＋" />
    </GridLayout>
    <LinearLayout android:id="@+id/pet_hero" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_home_panel" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingBottom="12dp">
      <LinearLayout android:id="@+id/pet_detail_card" android:layout_width="match_parent" android:layout_height="210dp" android:gravity="center" android:orientation="vertical" android:visibility="gone">
        <TextView android:id="@+id/pet_detail_emoji" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🐱" android:textSize="72sp" />
        <TextView android:id="@+id/pet_detail_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Your pet is ready" android:textColor="#30255F" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="A little friend on your screen" android:textColor="#897CE7" android:textSize="14sp" />
      </LinearLayout>
      <LinearLayout android:id="@+id/pet_choose_header" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/choose_your_pet" android:textColor="#27205F" android:textSize="17sp" android:textStyle="bold" />
        <TextView android:id="@+id/pet_more" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:text="@string/view_more" android:textColor="#8B69FB" android:textSize="13sp" />
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="52dp" android:layout_height="wrap_content" android:text="@string/hot" android:textColor="#FF4CAA" android:textSize="14sp" android:textStyle="bold" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/pet_categories" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        <TextView android:id="@+id/pet_sort" android:layout_width="32dp" android:layout_height="match_parent" android:gravity="center" android:text="☷↕" android:textColor="#30255F" android:textSize="19sp" />
      </LinearLayout>
      <androidx.recyclerview.widget.RecyclerView android:id="@+id/pet_grid" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" />
    </LinearLayout>
    <TextView style="@style/FeatureSection" android:text="@string/pet_settings" />
    <TextView android:id="@+id/pet_position" style="@style/FeatureAction" android:text="@string/position" />
    <TextView android:id="@+id/pet_motion" style="@style/FeatureAction" android:text="@string/movement" />
    <TextView android:id="@+id/pet_apply" style="@style/FeaturePrimary" android:text="@string/apply_pet" />
</LinearLayout>
