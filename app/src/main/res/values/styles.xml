<resources>

    <style name="IntroIndicator">
        <item name="android:layout_width">10dp</item>
        <item name="android:layout_height">10dp</item>
        <item name="android:layout_marginHorizontal">4dp</item>
        <item name="android:background">@drawable/bg_intro_indicator</item>
    </style>

    <style name="HomeShortcut">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="HomeShortcutTile">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">78dp</item>
        <item name="android:layout_marginHorizontal">1.5dp</item>
        <item name="android:background">@drawable/bg_home_shortcut</item>
    </style>

    <style name="HomeShortcutLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">9dp</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/nunito</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
        <item name="android:breakStrategy">simple</item>
        <item name="android:hyphenationFrequency">none</item>
        <item name="android:textColor">#27205F</item>
        <item name="android:textSize">9sp</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="FeatureSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">#897CE7</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FeatureAction">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginBottom">9dp</item>
        <item name="android:background">@drawable/bg_home_panel</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">15dp</item>
        <item name="android:textColor">#27205F</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="FeaturePrimary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_primary_button</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="PetSlot">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">109dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:background">@drawable/bg_pet_slot</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#897CE7</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="CustomizeCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">150dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/bg_home_panel</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">8dp</item>
        <item name="android:textColor">#30255F</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="EmojiSwitch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:thumb">@drawable/toggle_thumb</item>
        <item name="track">@drawable/toggle_track</item>
        <item name="thumbTint">@null</item>
        <item name="trackTint">@null</item>
        <item name="switchMinWidth">60dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="switchPadding">12dp</item>
        <item name="splitTrack">false</item>
        <item name="showText">false</item>
    </style>
</resources>
