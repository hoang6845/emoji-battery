<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingHorizontal="18dp" android:paddingTop="8dp" android:paddingBottom="8dp">
    <include android:id="@+id/charging_controls" layout="@layout/layout_charging_controls"/>
    <com.hd.emojibattery.ui.common.BoundedCatalogRecyclerView android:id="@+id/charging_categories" android:layout_width="match_parent" android:layout_height="44dp"/>
    <LinearLayout android:id="@+id/charging_success" android:layout_width="match_parent" android:layout_height="480dp" android:gravity="center" android:orientation="vertical" android:visibility="gone">
        <TextView android:layout_width="96dp" android:layout_height="96dp" android:gravity="center" android:background="@drawable/bg_primary_button" android:text="✓" android:textColor="#FFFFFF" android:textSize="52sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:gravity="center" android:text="Applied successfully" android:textColor="#27205F" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:text="Your charging style is ready" android:textColor="#897CE7" android:textSize="16sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/charging_preview" android:layout_width="match_parent" android:layout_height="410dp" android:background="@drawable/bg_primary_button" android:gravity="center" android:orientation="vertical">
        <TextView android:id="@+id/charging_emoji" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🐶" android:textSize="72sp" />
        <TextView android:id="@+id/charging_percent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="86%" android:textColor="#FFFFFF" android:textSize="54sp" android:textStyle="bold" />
        <TextView android:id="@+id/charging_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Charging • 28.0°C" android:textColor="#FFFFFF" android:textSize="15sp" />
    </LinearLayout>
    <TextView android:id="@+id/charging_animation" style="@style/FeatureAction" android:text="🎞   Animation" />
    <TextView android:id="@+id/charging_wallpaper" style="@style/FeatureAction" android:text="🖼   Wallpaper" />
    <TextView android:id="@+id/charging_preview_full" style="@style/FeatureAction" android:text="Preview full screen" />
    <TextView android:id="@+id/charging_apply" style="@style/FeaturePrimary" android:text="Apply" />
    <com.hd.emojibattery.ui.common.BoundedCatalogRecyclerView android:id="@+id/charging_grid" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="8dp" android:visibility="gone" />
</LinearLayout>
