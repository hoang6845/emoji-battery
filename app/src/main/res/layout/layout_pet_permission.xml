<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/pet_permission_overlay" android:layout_width="match_parent" android:layout_height="match_parent" android:clickable="true" android:visibility="gone">
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#99000000" />
    <ScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:background="@drawable/bg_bottom_sheet_white" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="19dp" android:paddingTop="24dp" android:paddingEnd="19dp" android:paddingBottom="4dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="10dp" android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:layout_width="23dp" android:layout_height="23dp" android:src="@drawable/pet_permission_warning" android:importantForAccessibility="no" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="9dp" android:text="Permission Required" android:textSize="18sp" android:textColor="#27205F" android:textFontWeight="600" android:includeFontPadding="false" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="42dp" android:layout_marginHorizontal="10dp" android:layout_marginTop="10dp" android:includeFontPadding="false" android:gravity="center_vertical" android:text="Allow Display over other apps to display your custom battery features" android:textSize="16sp" android:textColor="#8E85B5" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_pet_permission_steps" android:orientation="vertical" android:paddingHorizontal="19dp" android:paddingVertical="17dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="Follow these steps to grant permission:" android:textSize="14sp" android:textColor="#27205F" android:textFontWeight="600" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:includeFontPadding="false" android:lineSpacingMultiplier="1.54" android:text="1. Go to Settings\n2. Select “Emoji Battery: Icon Themes”\n3. Allow the permission: “Display over other apps”" android:textSize="14sp" android:textColor="#27205F" />
                <FrameLayout android:layout_width="match_parent" android:layout_height="88dp" android:layout_marginTop="12dp" android:paddingHorizontal="10dp" android:paddingVertical="13dp" android:background="@drawable/bg_pet_permission_example">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_pet_permission_row" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="18dp" android:paddingEnd="14dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:includeFontPadding="false" android:text="Display over other apps" android:textSize="14sp" android:textColor="#27205F" android:textFontWeight="600" />
                        <androidx.appcompat.widget.SwitchCompat android:id="@+id/pet_permission_switch" android:layout_width="60dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:contentDescription="Display over other apps" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
            <TextView android:id="@+id/pet_permission_continue" android:layout_width="match_parent" android:layout_height="57dp" android:layout_marginTop="9dp" android:background="@drawable/bg_primary_button" android:gravity="center" android:text="Continue to Settings" android:textSize="18sp" android:textColor="#FFFFFF" android:textFontWeight="600" />
            <TextView android:id="@+id/pet_permission_dismiss" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp" android:gravity="center" android:text="Not now" android:textSize="14sp" android:textColor="#8F85B5" android:textFontWeight="600" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
