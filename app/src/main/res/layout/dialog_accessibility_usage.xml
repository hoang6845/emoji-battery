<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/bg_home_panel" android:fillViewport="true"
    android:clipChildren="false" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp"
        android:clipChildren="false" android:clipToPadding="false">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/accessibility_usage_title" android:textSize="22sp"
            android:fontFamily="@font/nunito_bold" android:textColor="#27205F" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/accessibility_usage_subtitle"
            android:textSize="15sp" android:textColor="#776D9B" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:padding="16dp" android:background="@drawable/bg_plan"
            android:text="@string/accessibility_usage_reasons" android:textSize="14sp"
            android:lineSpacingExtra="5dp" android:textColor="#27205F" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/accessibility_usage_privacy"
            android:textSize="14sp" android:lineSpacingExtra="4dp" android:textColor="#776D9B" />
        <androidx.appcompat.widget.AppCompatCheckBox android:id="@+id/accessibility_agree"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:layout_marginTop="14dp" android:buttonTint="#8B69FB"
            android:text="@string/accessibility_usage_agree" android:textColor="#27205F" android:textSize="14sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp"
            android:paddingVertical="6dp" android:clipChildren="false" android:clipToPadding="false">
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/accessibility_close"
                android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
                android:layout_marginEnd="12dp" android:background="@drawable/bg_plan"
                android:backgroundTint="@null" android:text="@string/accessibility_usage_close"
                android:textAllCaps="false" android:textColor="#27205F" android:textSize="16sp" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/accessibility_next"
                android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
                android:background="@drawable/bg_primary_button" android:backgroundTint="@null"
                android:enabled="false" android:alpha="0.4" android:text="@string/accessibility_usage_next"
                android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
