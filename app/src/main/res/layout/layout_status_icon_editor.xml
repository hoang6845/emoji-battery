<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp" android:background="@drawable/bg_home_panel">
    <LinearLayout android:id="@+id/icon_editor_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_status_outline">
    <LinearLayout android:layout_width="match_parent" android:layout_height="41dp">
        <TextView android:fontFamily="@font/nunito_medium" android:id="@+id/icon_signal" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center"  android:text="Signal" android:textColor="#27205F"/>
        <TextView android:fontFamily="@font/nunito_medium" android:id="@+id/icon_data" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center"  android:text="Data" android:textColor="#27205F"/>
        <TextView android:fontFamily="@font/nunito_medium" android:id="@+id/icon_charge" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center"  android:text="Charge" android:textColor="#27205F"/>
    </LinearLayout>
    <TextView android:fontFamily="@font/nunito_medium" android:layout_width="match_parent" android:layout_height="22dp" android:gravity="center_vertical" android:layout_marginTop="25dp" android:layout_marginBottom="14dp" android:textSize="16sp" android:text="Icon Color" android:textColor="#27205F"/>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="48dp" android:scrollbars="none">
    <LinearLayout android:id="@+id/icon_colors" android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center_vertical"/>
    </HorizontalScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="22dp" android:layout_marginTop="25dp" android:gravity="center_vertical">
        <TextView android:fontFamily="@font/nunito_medium" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Size" android:textSize="16sp" android:textColor="#27205F"/>
        <TextView android:fontFamily="@font/nunito_medium" android:id="@+id/icon_size_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="15dp" android:textSize="16sp" android:textColor="#27205F"/>
    </LinearLayout>
    <SeekBar android:id="@+id/icon_size" android:layout_width="match_parent" android:layout_height="24dp" android:layout_marginTop="14dp" android:max="30" android:progress="15" android:splitTrack="false" android:thumb="@drawable/bg_slider_thumb" android:progressDrawable="@drawable/bg_slider_track" android:progressTint="@null" android:progressBackgroundTint="@null" android:thumbTint="@null"/>

    <TextView android:fontFamily="@font/nunito_medium" android:layout_width="match_parent" android:layout_height="22dp" android:layout_marginTop="25dp" android:layout_marginBottom="7dp" android:id="@+id/icon_style_label" android:textSize="16sp" android:text="Style" android:textColor="#27205F"/>
    <GridLayout android:id="@+id/icon_styles" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="4"/>
    </LinearLayout>
</LinearLayout>
