<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/pet_flow_modal" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#B3000000" />
    <include android:id="@+id/pet_download_card" layout="@layout/dialog_pet_download" android:layout_width="match_parent" android:layout_height="207dp" android:layout_gravity="center" android:layout_marginHorizontal="22dp" android:visibility="gone" />
    <LinearLayout android:id="@+id/pet_rating_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginHorizontal="22dp" android:background="@drawable/bg_plan" android:gravity="center_horizontal" android:orientation="vertical" android:padding="18dp" android:visibility="gone">
        <ImageView android:layout_width="135dp" android:layout_height="135dp" android:src="@drawable/pet_rating_art"/>
        <TextView android:layout_width="match_parent" android:layout_height="34dp" android:gravity="center" android:text="Do you like the app?" android:textColor="#30255F" android:textSize="18sp" />
        <TextView android:layout_width="match_parent" android:layout_height="54dp" android:gravity="center" android:text="Your feedback help us improve!\nThe best rating for us" android:textColor="#999999" android:textSize="13sp" />
        <TextView android:id="@+id/pet_rating_stars" android:layout_width="match_parent" android:layout_height="50dp" android:gravity="center" android:text="☆  ☆  ☆  ☆  ☆" android:textColor="#D1D1D1" android:textSize="32sp" />
        <TextView android:id="@+id/pet_rating_rate" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="14dp" android:background="@drawable/bg_primary_button" android:gravity="center" android:text="Rate us" android:textColor="#FFFFFF" android:textSize="16sp" />
        <TextView android:id="@+id/pet_rating_later" android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center" android:text="Maybe Later" android:textColor="#999999" android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/pet_sort_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginHorizontal="11dp" android:gravity="center_horizontal" android:orientation="vertical" android:visibility="gone">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/pet_sort_categories" android:layout_width="match_parent" android:layout_height="441dp" android:background="@drawable/bg_pet_dialog" android:paddingHorizontal="10dp" android:paddingVertical="24dp" android:clipToPadding="true" android:scrollbars="vertical" android:nestedScrollingEnabled="true" />
        <ImageButton android:id="@+id/pet_sort_close" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginTop="13dp" android:background="@android:color/transparent" android:src="@drawable/figma_pet_close" android:scaleType="centerInside" android:contentDescription="Close categories" />
    </LinearLayout>
    <LinearLayout android:id="@+id/pet_exit_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginHorizontal="22dp" android:background="@drawable/bg_plan" android:orientation="vertical" android:padding="22dp" android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center" android:text="Discard Changes?" android:textColor="#30255F" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="50dp" android:gravity="center" android:text="You have unsaved changes. Are you sure you want to leave?" android:textColor="#897CE7" android:textSize="14sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal">
            <TextView android:id="@+id/pet_exit_confirm" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:background="@drawable/bg_catalog_card" android:gravity="center" android:text="Exit" android:textColor="#27205F" android:textSize="15sp"/>
            <TextView android:id="@+id/pet_exit_keep" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_marginStart="6dp" android:background="@drawable/bg_primary_button" android:gravity="center" android:text="Keep Editing" android:textColor="#FFFFFF" android:textSize="15sp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
